# =============================================================================
# Caddy — a única porta aberta do servidor. Termina o TLS e distribui.
#
#   https://<dominio>/api/*        -> backend  (exige X-API-Key)
#   https://<dominio>/webhooks/*   -> backend  (valida o próprio remetente)
#   https://<dominio>/health       -> backend
#   https://<dominio>/*            -> painel   (o nginx do front faz o
#                                               fallback de SPA sozinho)
#
# O certificado é emitido e renovado sozinho pelo Let's Encrypt, desde que o
# DNS do domínio já aponte para o IP deste servidor ANTES da primeira subida.
#
# Duas coisas que de propósito NÃO estão publicadas:
#   * /docs e /openapi.json — o Swagger não precisa estar na internet; quem
#     precisar lê de dentro do servidor (`curl localhost:8000/docs`).
#   * o Supabase Studio — é um administrador de banco completo, exposto sem
#     autenticação própria. O acesso é por túnel SSH, ver DEPLOY.md.
# =============================================================================
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	log {
		output stdout
		format json
	}

	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /webhooks/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	# Tudo o mais é o painel. Precisa ser o último bloco: `handle` casa por
	# especificidade, e este, sem caminho, é o pega-tudo.
	handle {
		reverse_proxy frontend:8080
	}
}
