# =============================================================================
# Mi Piace — variáveis de produção (COPIAR PARA .env.prod, NUNCA VERSIONAR)
# =============================================================================

# --- Domínios e URLs ---
DOMAIN=mipiace.example.com
ACME_EMAIL=admin@example.com
PUBLIC_BASE_URL=https://mipiace.example.com

# Frontend build args (deve ser reconstruído ou usar um .env runtime)
VITE_API_BASE_URL=https://mipiace.example.com/api
VITE_ADMIN_API_KEY=change-me-long-random-key-here

# --- Banco de dados Postgres ---
POSTGRES_PASSWORD=change-me-long-random-password-123
POSTGRES_DB=mipiace_prod
POSTGRES_PORT=5432

# --- Autenticação e Segurança ---
ADMIN_API_KEY=change-me-long-random-admin-key-456
JWT_SECRET=change-me-long-random-jwt-secret-789
CORS_ORIGINS=https://mipiace.example.com

# --- Ambiente ---
ENVIRONMENT=production
DEBUG=false
FAKE_MODE=false

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp (Evolution API self-hosted) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me-evolution-api-key-111
EVOLUTION_INSTANCE=mipiace_prod
EVOLUTION_WEBHOOK_TOKEN=change-me-evolution-webhook-token-222
EVOLUTION_WEBHOOK_ENABLED=true

# --- Mercado Pago (Pix) ---
MP_ACCESS_TOKEN=APP_USR-your-production-mercado-pago-token
MP_WEBHOOK_SECRET=change-me-mercado-pago-webhook-secret

# --- Delivery ---
DELIVERY_FEE=5.00

# --- Supabase Studio (admin only) ---
STUDIO_USER=admin
STUDIO_PASS=change-me-studio-password-333

# --- Evolution DB (se rodando localmente) ---
EVOLUTION_POSTGRES_PASSWORD=change-me-evolution-db-password
