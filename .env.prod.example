# =============================================================================
# Mi Piace — variáveis de produção.
#
#   cp .env.prod.example .env.prod   (e depois: --env-file .env.prod)
#
# NUNCA versionar o .env.prod preenchido. O passo a passo está no DEPLOY.md.
# =============================================================================

# --- Domínio -----------------------------------------------------------------
# Sem https://. O DNS já precisa apontar para o IP deste servidor quando o
# Caddy subir pela primeira vez, senão o Let's Encrypt não emite o certificado.
DOMAIN=mipiace.com.br
ACME_EMAIL=voce@exemplo.com

# Como a API se enxerga de fora. É daqui que sai a notification_url mandada ao
# Mercado Pago — se estiver errada, o Pix é cobrado mas nunca confirma.
PUBLIC_BASE_URL=https://mipiace.com.br
CORS_ORIGINS=https://mipiace.com.br

# O painel chama a API pelo mesmo domínio, através do Caddy.
VITE_API_BASE_URL=https://mipiace.com.br/api

# --- Ambiente ----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Obrigatoriamente false: com true o LLM e o Pix são falsos e ninguém paga nada.
FAKE_MODE=false

# --- Banco -------------------------------------------------------------------
# Gere com: openssl rand -hex 32
# Só vale na PRIMEIRA subida: depois disso a senha está dentro do volume pgdata
# e trocá-la aqui só faz o backend não conseguir mais conectar.
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# --- Chave do painel e da API ------------------------------------------------
# Header X-API-Key de toda rota /api/*. Gere com: openssl rand -hex 32
# É embutida no bundle do front em tempo de BUILD e fica visível no navegador:
# trate o painel como aplicação interna. Trocar exige rebuild do frontend.
ADMIN_API_KEY=

# --- IA ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp (Evolution API) ------------------------------------------------
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_INSTANCE=mipiace
# Gere as duas com: openssl rand -hex 24
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=
EVOLUTION_WEBHOOK_ENABLED=true
# Tem que repetir o token acima — é a URL que a Evolution chama, e o token na
# query string é a única validação que esse webhook tem.
EVOLUTION_WEBHOOK_URL=http://backend:8000/webhooks/evolution?token=COLE_O_EVOLUTION_WEBHOOK_TOKEN_AQUI

# --- Mercado Pago (Pix) ------------------------------------------------------
# Credenciais de PRODUÇÃO (Suas integrações → sua aplicação → Credenciais de
# produção). O token de conta de teste começa igual, com APP_USR-, mas só
# funciona em sandbox: confira em https://api.mercadopago.com/users/me que o
# nickname não é TESTUSER...
MP_ACCESS_TOKEN=
# Suas integrações → sua aplicação → Webhooks → Assinatura secreta.
MP_WEBHOOK_SECRET=

# --- Trava de contatos -------------------------------------------------------
# Vazio: o agente atende qualquer cliente (produção normal).
# Com números separados por vírgula: só eles conversam com o agente, e o bot
# se recusa a enviar para qualquer outro. É como deixar a loja no ar para
# testar pelo WhatsApp de verdade sem risco de atender cliente pela metade.
ALLOWED_PHONES=

# --- Regras de negócio -------------------------------------------------------
DELIVERY_FEE=5.00

# --- Ritmo de envio no WhatsApp (ver back/app/agent/pacing.py) ---------------
# Os defaults já são conservadores; mexa só se souber por quê.
WA_TYPING_WPM=45
WA_MIN_SECONDS_BETWEEN_MESSAGES=3
WA_MAX_MESSAGES_PER_MINUTE=12
# Quanto o agente espera, depois de cada mensagem, para ver se o cliente ainda
# está digitando. Quem pede pelo WhatsApp escreve picado ("quero um pote" / "G"
# / "de pistache"); com isto os balões viram um pedido só. 0 desliga.
WA_DEBOUNCE_SECONDS=3

# --- Atendimento humano ------------------------------------------------------
# Depois de escalar, o bot fica mudo por este tempo esperando alguém da loja
# responder pelo celular. Passado isso sem resposta humana, ele reassume a
# conversa em vez de deixar o cliente falando sozinho.
HANDOFF_RETURN_MINUTES=15
