# =============================================================================
# Mi Piace — frontend (copie para .env.local e ajuste se precisar)
# =============================================================================
# Atenção: tudo que começa com VITE_ é embutido no bundle no momento do build
# e fica visível para quem abrir o navegador. Só coloque aqui valores que o
# painel administrativo pode expor — nada de segredo de produção.
# =============================================================================

# Base da API FastAPI. Em docker compose o backend responde em http://localhost:8000
# a partir do navegador do host (o container publica a porta 8000).
VITE_API_BASE_URL=http://localhost:8000

# Chave enviada no header X-API-Key das rotas administrativas.
# Precisa bater com ADMIN_API_KEY do back/.env.
VITE_ADMIN_API_KEY=dev-local-key
