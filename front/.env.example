# =============================================================================
# Frontend — copie para `.env.local` e ajuste
# =============================================================================
# O Vite embute estes valores em tempo de BUILD: mudar depois exige rebuildar
# a imagem, não basta reiniciar o container.
# =============================================================================

# Onde o backend responde.
VITE_API_BASE_URL=http://localhost:8000

# Header X-API-Key das rotas administrativas. Tem de bater com ADMIN_API_KEY do
# backend. Atenção: vai no bundle, ou seja, quem abre o painel consegue lê-la —
# é chave de operação interna, não de cliente final.
VITE_ADMIN_API_KEY=dev-local-key

# --- A loja ------------------------------------------------------------------
# O painel serve a qualquer casa do mesmo nicho; o nome não vive no código.
VITE_STORE_NAME=Mi Piace Gelateria
# Arquivo em `front/public/`. Vazio = o cabeçalho mostra o nome em texto, que é
# o que uma loja nova tem no primeiro dia.
VITE_STORE_LOGO_URL=/logo-mipiace.png
