# =============================================================================
# Variáveis de ambiente — copie para `.env` e preencha
# =============================================================================
# Esta lista é COMPLETA: toda chave lida por `app/core/config.py` aparece aqui,
# na mesma ordem. Se você adicionar um campo em `Settings`, adicione aqui junto
# — é este arquivo que a documentação manda ler, e não há uma terceira lista.
#
# Com FAKE_MODE=true o projeto roda inteiro localmente SEM nenhuma chave real:
# o LLM e o Mercado Pago são substituídos por implementações falsas.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME=Atendimento WhatsApp
ENVIRONMENT=development
DEBUG=true
# Usada no `notification_url` do Pix e no domínio do e-mail técnico do pagador.
PUBLIC_BASE_URL=http://localhost:8000

# --- Banco -------------------------------------------------------------------
# O Postgres do docker-compose é a imagem supabase/postgres (usuário/banco
# padrão "postgres"), com nosso schema.sql/seed.sql aplicados no 1º boot.
DATABASE_URL=postgresql+psycopg://postgres:dev-supabase-postgres-password@localhost:5432/postgres

# --- Segurança ---------------------------------------------------------------
# Header X-API-Key exigido nas rotas administrativas.
ADMIN_API_KEY=dev-local-key
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Modo de desenvolvimento -------------------------------------------------
# true  -> LLM falso + pagamento falso, roda sem chave nenhuma
# false -> OpenAI + Mercado Pago de verdade
FAKE_MODE=true

# --- IA (OpenAI) — só necessário com FAKE_MODE=false -------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=20

# --- WhatsApp via Evolution API — só necessário com FAKE_MODE=false ----------
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=dev-evolution-key
EVOLUTION_INSTANCE=mipiace
EVOLUTION_WEBHOOK_TOKEN=dev-evolution-webhook-token

# --- Trava de contatos -------------------------------------------------------
# VAZIA = aberto, que é o normal em produção. Com números dentro, o agente só
# fala com eles — é como testar pelo WhatsApp de verdade com a loja no ar.
ALLOWED_PHONES=

# --- Ritmo de envio no WhatsApp ----------------------------------------------
# O cliente é não-oficial: o que protege o número é o bot não parecer um bot.
# Ver `app/agent/pacing.py`.
WA_TYPING_WPM=45
WA_MIN_SECONDS_BETWEEN_MESSAGES=3
WA_MAX_MESSAGES_PER_MINUTE=12
# Janela para juntar os balões seguidos do mesmo cliente. 0 desliga.
WA_DEBOUNCE_SECONDS=3

# --- Mercado Pago — só necessário com FAKE_MODE=false ------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Regras de negócio -------------------------------------------------------
DELIVERY_FEE=5.00
PIX_EXPIRATION_MINUTES=30
SESSION_TTL_MINUTES=60
# Quanto tempo o bot fica calado esperando alguém da loja assumir a conversa.
HANDOFF_RETURN_MINUTES=15

# =============================================================================
# A LOJA — é aqui que uma empresa nova é configurada
# =============================================================================
# Nenhum nome de cliente vive no código. Para atender outra casa, muda-se este
# bloco e o catálogo (pela tela de Produtos); o resto do sistema é o mesmo.
STORE_NAME=Mi Piace Gelateria
# Abre a saudação e o cardápio. Deixe vazio para não usar emoji nenhum.
STORE_EMOJI=🍨
# O ramo em uma palavra — entra no prompt para situar o modelo.
STORE_SEGMENT=gelateria
# Cidade do recebedor; o BR Code do Pix carrega este campo.
STORE_CITY=SAO PAULO

# As quatro abaixo são opcionais e ficam em branco de propósito: sem elas o
# agente diz que não sabe e oferece chamar alguém, o que é melhor do que
# inventar o horário de uma loja fechada.
STORE_HOURS=
STORE_ADDRESS=
STORE_DELIVERY_AREA=
STORE_DELIVERY_ESTIMATE=
