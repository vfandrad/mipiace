# =============================================================================
# Mi Piace — variáveis de ambiente (copie para .env e preencha)
# =============================================================================
# Com FAKE_MODE=true o projeto roda inteiro localmente SEM nenhuma chave real:
# o LLM e o Mercado Pago são substituídos por implementações falsas.
# =============================================================================

ENVIRONMENT=development
DEBUG=true
FAKE_MODE=true
PUBLIC_BASE_URL=http://localhost:8000

# --- Banco -------------------------------------------------------------------
# O Postgres do docker-compose é a imagem supabase/postgres (usuário/banco
# padrão "postgres"), com nosso schema.sql/seed.sql aplicados no 1º boot.
DATABASE_URL=postgresql+psycopg://postgres:dev-supabase-postgres-password@localhost:5432/postgres

# --- Segurança ---------------------------------------------------------------
# Header X-API-Key exigido nas rotas administrativas
ADMIN_API_KEY=dev-local-key
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- IA (OpenAI) — só necessário com FAKE_MODE=false -------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=20

# --- WhatsApp via Evolution API — só necessário com FAKE_MODE=false ----------
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=dev-evolution-key
EVOLUTION_INSTANCE=mipiace
EVOLUTION_WEBHOOK_TOKEN=dev-evolution-webhook-token

# --- Mercado Pago — só necessário com FAKE_MODE=false ------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Regras de negócio -------------------------------------------------------
DELIVERY_FEE=5.00
PIX_EXPIRATION_MINUTES=30
SESSION_TTL_MINUTES=60
# Falhas seguidas de entendimento antes de cair para atendimento humano.
MAX_NLU_FAILURES=3

# --- Dados da loja (opcionais) ----------------------------------------------
# O agente responde "que horas vocês abrem?", "onde fica?", "vocês entregam
# aqui?" e "quanto demora?" a partir daqui. Em branco, ele diz que não sabe e
# oferece chamar alguém — melhor do que inventar horário de loja.
STORE_HOURS=
STORE_ADDRESS=
STORE_DELIVERY_AREA=
STORE_DELIVERY_ESTIMATE=
